<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_l10n_ma_ras" model="ir.ui.view">
        <field name="name">account.move.form.l10n.ma.ras</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='account_id']" position="after">
                <field name="l10n_ma_ras_nature" optional="hide"
                    column_invisible="parent.move_type != 'in_invoice'"/>
            </xpath>
            <xpath expr="//group[@name='accounting_info_group']" position="after">
                <group string="RAS TVA (Maroc)" name="l10n_ma_ras_group"
                    invisible="move_type != 'in_invoice'">
                    <field name="l10n_ma_ras_applicable"/>
                    <field name="l10n_ma_ras_taux" invisible="not l10n_ma_ras_applicable"/>
                    <field name="l10n_ma_ras_amount" invisible="not l10n_ma_ras_applicable"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
