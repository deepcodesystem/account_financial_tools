<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_journal_form_l10n_ma_edi_rd" model="ir.ui.view">
        <field name="name">account.journal.form.l10n.ma.edi.rd</field>
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account.view_account_journal_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='outbound_payment_method_line_ids']/list/field[@name='name']" position="after">
                <field name="l10n_ma_rd_mode_paiement"/>
            </xpath>
            <xpath expr="//field[@name='inbound_payment_method_line_ids']/list/field[@name='name']" position="after">
                <field name="l10n_ma_rd_mode_paiement"/>
            </xpath>
            <xpath expr="//page[@name='advanced_settings']/group" position="inside">
                <group string="Maroc EDI RD">
                    <field name="l10n_ma_rd_mode_paiement"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
